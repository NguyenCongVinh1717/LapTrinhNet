<Window x:Class="CuoiKy2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CuoiKy2"
        mc:Ignorable="d"
        Title="Quản lý dược phẩm" Height="600" Width="800">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Blue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Aqua"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"
                   Grid.ColumnSpan="2" Margin="5">QUẢN LÝ DƯỢC PHẨM</TextBlock>
        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Mã thuốc:</Label>
        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Tên thuốc:</Label>
        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Giá bán:</Label>
        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">Số lượng:</Label>
        <Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">Danh mục thuốc:</Label>
        <TextBox x:Name="matxt" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="tentxt" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="giatxt" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="soluongtxt" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
        <ComboBox x:Name="danhmuccbb" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Width="400" Height="30" HorizontalAlignment="Left" Margin="5"/>
        <DataGrid x:Name="dgvTT" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Height="200" Width="700"
                  HorizontalAlignment="Center" Margin="5" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="selection_changed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã thuốc" Binding="{Binding MaThuoc}" Width="100"/>
                <DataGridTextColumn Header="Tên thuốc" Binding="{Binding TenThuoc}" Width="150"/>
                <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan}" Width="100"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="100"/>
                <DataGridTextColumn Header="Danh mục thuốc" Binding="{Binding MaDm}" Width="148"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                    Orientation="Horizontal" Margin="10">
            <Button x:Name="btnThem" Click="btnThem_Click">Thêm</Button>
            <Button x:Name="btnSua" Click="btnSua_Click">Sửa</Button>
            <Button x:Name="btnXoa" Click="btnXoa_Click">Xoá</Button>
            <Button x:Name="btnTim" Click="btnTim_Click">Tìm</Button>
            <Button x:Name="btnThongKe" Click="btnThongKe_Click">Thống kê</Button>
            <Button x:Name="btnXoaForm" Click="btnXoaForm_Click">Xoá form</Button>
            <Button x:Name="btnDong" Click="btnDong_Click">Đóng</Button>
        </StackPanel>
    </Grid>
</Window>
