<Window x:Class="CuoiKy2.MyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CuoiKy2"
        mc:Ignorable="d"
        Title="MyWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dgvTK" Width="700" Height="200" HorizontalAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã danh mục" Binding="{Binding MaDm}"/>
                <DataGridTextColumn Header="Tên danh mục" Binding="{Binding TenDm}"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
