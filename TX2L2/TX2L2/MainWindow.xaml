<Window x:Class="TX2L2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TX2L2"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Quản lý học sinh" Height="600" Width="800">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Text" Value=" "/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="Aqua"/>
        </Style>
    </Window.Resources>
    <Grid Background="Beige">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,10,0,20" FontSize="30" FontWeight="Bold" Foreground="Blue">QUẢN LÝ HỌC SINH</TextBlock>
        <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left">Mã sinh viên:</Label>
        <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left">Họ tên:</Label>
        <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left">Ngày sinh:</Label>
        <Label Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left">Giới tính:</Label>
        <Label Grid.Row="5" Grid.Column="0" HorizontalAlignment="Left">Lớp:</Label>
        <Label Grid.Row="6" Grid.Column="0" HorizontalAlignment="Left">Điểm:</Label>
        <TextBox x:Name="txtma" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"/>
        <TextBox x:Name="txthoten" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"/>
        <DatePicker x:Name="datens" Grid.Row="3" Grid.Column="1" Width="200" Height="30" HorizontalAlignment="Left" Margin="5"></DatePicker>
        <StackPanel Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Orientation="Horizontal" Margin="5">
            <RadioButton x:Name="radnam" Content="Nam" Margin="0,0,40,0" GroupName="gioitinh" IsChecked="True"/>
            <RadioButton x:Name="radnu" Content="Nữ" GroupName="gioitinh"/>
        </StackPanel>
        <ComboBox x:Name="cbblop" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" SelectedIndex="0"/>
        <TextBox x:Name="txtdiem" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left"/>
        <Border BorderBrush="Green" BorderThickness="5" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <DataGrid x:Name="dgvHienThi" SelectedCellsChanged="click_Cell" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Height="180" Width="650" Margin="10" VerticalScrollBarVisibility="Auto" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã sinh viên" Width="100" Binding="{Binding masv}"/>
                    <DataGridTextColumn Header="Họ tên" Width="150" Binding="{Binding hoten}"/>
                    <DataGridTextColumn Header="Giới tính" Width="100" Binding="{Binding ngaysinh}"/>
                    <DataGridTextColumn Header="Ngày sinh" Width="100" Binding="{Binding gioitinh}"/>
                    <DataGridTextColumn Header="Lớp" Width="100" Binding="{Binding lop}"/>
                    <DataGridTextColumn Header="Điểm" Width="100" Binding="{Binding diem}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="btnThem" Click="btnThem_Click">Thêm</Button>
            <Button x:Name="btnSua" Click="btnSua_Click">Sửa</Button>
            <Button x:Name="btnXoa" Click="btnXoa_Click">Xoá</Button>
            <Button x:Name="btnTim" Click="btnTim_Click">Tìm kiếm</Button>
            <Button x:Name="btnXoaForm" Click="btnXoaForm_Click">Xoá form</Button>
            <Button x:Name="btnTaiLai" Click="btnTaiLai_Click">Đóng</Button>
        </StackPanel>
    </Grid>
</Window>
