<Window x:Class="cuoiKy1.MyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cuoiKy1"
        mc:Ignorable="d"
        Title="MyWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dgvTK" HorizontalAlignment="Center" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Width="500" Height="150">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã loại" Binding="{Binding maLoai}" Width="120"/>
                <DataGridTextColumn Header="Tên loại" Binding="{Binding tenLoai}" Width="200"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
