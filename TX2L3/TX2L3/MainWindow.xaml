<Window x:Class="TX2L3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TX2L3"
        mc:Ignorable="d"
        Title="Quản lý nhân viên" Height="800" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="Aqua"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="25">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="400"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="400"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="400"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    <Border Background="Coral">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                FontSize="30" Foreground="Blue" FontWeight="Bold" Margin="10">QUẢN LÝ THÔNG TIN NHÂN VIÊN</TextBlock>
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Green" BorderThickness="5" Background="Beige">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Mã nhân viên:</Label>
                    <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Họ tên:</Label>
                    <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Ngày sinh:</Label>
                    <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Giới tính:</Label>
                    <Label Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Phòng ban:</Label>
                    <Label Grid.Row="5" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">Hệ số lương:</Label>
                    <TextBox x:Name="txtma" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtten" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="10,10,0,10" Width="400"/>
                    <DatePicker x:Name="datans" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="radnam" GroupName="gt" IsChecked="True">Nam</RadioButton>
                        <RadioButton x:Name="radnu" GroupName="gt">Nữ</RadioButton>
                    </StackPanel>
                    <ComboBox x:Name="cbbphong" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" SelectedIndex="0">
                    </ComboBox>
                    <TextBox x:Name="txthsl" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <DataGrid x:Name="dgvHT" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" IsReadOnly="True" AutoGenerateColumns="False"
               Height="200" Margin="0,20,0,20" Width="700" SelectionChanged="selection_Changed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding manv}"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding hoten}"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding ngaysinh}"/>
                    <DataGridTextColumn Header="Giới tính" Binding="{Binding gioitinh}"/>
                    <DataGridTextColumn Header="Phòng ban" Binding="{Binding phongban}"/>
                    <DataGridTextColumn Header="Hệ số lương" Binding="{Binding hesoluong}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="Red"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="btnThem" Click="btnThem_Click">Thêm</Button>
                <Button x:Name="btnSua" Click="btnSua_Click">Sửa</Button>
                <Button x:Name="btnXoa" Click="btnXoa_Click">Xoá</Button>
                <Button x:Name="btnTim" Click="btnTim_Click">Tìm kiếm</Button>
                <Button x:Name="btnXoaForm" Click="btnXoaForm_Click">Xoá form</Button>
                <Button x:Name="btnDong" Click="btnDong_Click">Đóng</Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
