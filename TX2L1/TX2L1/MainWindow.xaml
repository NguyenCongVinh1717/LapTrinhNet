<Window x:Class="TX2L1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TX2L1"
        mc:Ignorable="d"
        Title="Quản lý thông tin nhân viên" Height="600" Width="800">
    <Grid>
        <Label Content="Mã nhân viên:" Margin="27,50,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Họ tên:" Margin="27,108,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Ngày sinh:" Margin="27,172,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Giới tính:" Margin="27,240,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Phòng ban:" Margin="27,298,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Hệ số lương:" Margin="27,361,0,0" RenderTransformOrigin="0.48,-0.759" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBox x:Name="txtma" HorizontalAlignment="Left" Margin="254,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="179" Height="30"/>
        <TextBox x:Name="txtten" HorizontalAlignment="Left" Margin="254,107,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="276" Height="30"/>
        <DatePicker x:Name="datens" HorizontalAlignment="Left" Margin="254,172,0,0" VerticalAlignment="Top" Height="30" Width="215"/>
        <RadioButton x:Name="radNam" Content="Nam" HorizontalAlignment="Left" Margin="254,240,0,0" VerticalAlignment="Top" GroupName="gioitinh" IsChecked="True"/>
        <RadioButton x:Name="radNu" Content="Nữ" HorizontalAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" GroupName="gioitinh"/>
        <ComboBox x:Name="cbbpb" HorizontalAlignment="Left" Margin="254,298,0,0" VerticalAlignment="Top" Width="230" Height="30"/>
        <TextBox x:Name="txthsl" HorizontalAlignment="Left" Margin="254,368,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" Height="30"/>
        <Label Content="QUẢN LÝ THÔNG TIN NHÂN VIÊN" HorizontalAlignment="Left" Margin="298,10,0,0" VerticalAlignment="Top" Foreground="#FF144BD9" FontSize="20" FontWeight="Bold"/>
        <DataGrid x:Name="dgNhanVien"
          Margin="27,420,27,20"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          SelectionChanged="dgNhanVien_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NV" Binding="{Binding manv}" Width="*"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding hoten}" Width="2*"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding ngaysinh}" Width="*"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding gioitinh}" Width="*"/>
                <DataGridTextColumn Header="Phòng ban" Binding="{Binding phongban}" Width="*"/>
                <DataGridTextColumn Header="Hệ số lương" Binding="{Binding hesoluong}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Thêm" HorizontalAlignment="Left" Margin="577,83,0,0" VerticalAlignment="Top" Height="50" Width="100" Background="#FF03C9BB" FontSize="16" Foreground="#FFE81A1A" Click="Button_Click"/>
        <Button x:Name="xoaBtn" Content="Xoá" HorizontalAlignment="Left" Margin="577,162,0,0" VerticalAlignment="Top" Height="50" Width="100" Background="#FF03C9BB" FontSize="16" Foreground="#FFE81A1A" RenderTransformOrigin="0.587,0.085" Click="xoaBtn_Click"/>
        <Button x:Name="xoaformBtn" Content="Xoá form" HorizontalAlignment="Left" Margin="577,240,0,0" VerticalAlignment="Top" Height="50" Width="100" Background="#FF03C9BB" FontSize="16" Foreground="#FFE81A1A" Click="xoaformBtn_Click"/>



    </Grid>
</Window>
